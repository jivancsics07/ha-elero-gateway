# Copy to /config/esphome/secrets.yaml on the Home Assistant box and fill in.
# The real file is not in this repository.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

mqtt_broker: "192.168.x.x"      # the Mosquitto broker add-on, i.e. the HA box
mqtt_username: "mqtt"
mqtt_password: "your-mqtt-password"

ota_password: "your-ota-password"
